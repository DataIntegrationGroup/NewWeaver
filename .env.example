# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_, and
# inlines them at build time. Everything here is optional.
# Only uncomment a line if you also set a value: an empty value overrides the default.

# PostHog product analytics. Leave VITE_POSTHOG_KEY empty to disable tracking
# (dev/CI emit nothing without it). Events are sent through the /ingest reverse
# proxy (see vite.config.ts and nginx/default.conf.template).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Upstream service endpoint overrides (optional — defaults live in src/config.ts).
# VITE_STA_BASE_URL=
# VITE_STA_ST2_BASE_URL=
# VITE_FEATURES_BASE_URL=
# VITE_DIE_FEATURES_BASE_URL=
# VITE_OCOTILLO_FEATURES_BASE_URL=
# VITE_USGS_OGC_BASE_URL=
# VITE_OSE_ARCGIS_BASE_URL=
# VITE_GEOSERVER_WFS_BASE_URL=
# VITE_GEOSERVER_OGC_FEATURES_BASE_URL=

# Nightly stats JSON for the home dashboard. Unset = counts derived locally and
# an empty activity feed.
# VITE_STATS_URL=

# Geocoding for location search.
# VITE_CENSUS_GEOCODER_URL=
# VITE_PHOTON_GEOCODER_URL=
# VITE_GEOCODER_BIAS=-106.0,34.5
